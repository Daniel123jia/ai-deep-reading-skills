{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperscope:schemas:deep-reading-result:1.2",
  "title": "PaperScope AI Deep Reading Result",
  "description": "Structured output contract for the PaperScope AI deep reading skill. Version 1.2 adds source boundary, evidence coverage, locator modes, snippet/paraphrase evidence refs, two-axis assumptions, claim-level support boundaries, and novelty verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_type",
    "input",
    "papers",
    "global_limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2"
    },
    "analysis_type": {
      "type": "string",
      "enum": ["limited_reading", "deep_reading"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "reading_mode", "reading_goal", "user_question", "provided_materials"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["title", "abstract", "parsed_text", "parsed_pdf", "url", "doi", "arxiv", "mixed"]
        },
        "reading_mode": {
          "type": "string",
          "enum": ["quick_summary", "standard", "reviewer_mode", "followup_mode", "method_only"],
          "description": "Resolved reading mode. Governs which output sections are required and where emphasis is placed."
        },
        "reading_goal": {
          "type": ["string", "null"],
          "description": "Raw user-stated goal or intent, before resolution to reading_mode."
        },
        "user_question": {
          "type": ["string", "null"]
        },
        "provided_materials": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "Up to 5 papers per call. For larger sets, run multiple calls and merge at the application layer.",
      "items": { "$ref": "#/$defs/paper_report" }
    },
    "global_limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },

  "$defs": {

    "paper_type": {
      "type": "string",
      "enum": ["method", "empirical", "theory", "review", "general", "unknown"]
    },

    "evidence_grade": {
      "type": "string",
      "enum": [
        "E0_TITLE_METADATA",
        "E1_ABSTRACT",
        "E2_BODY_TEXT",
        "E3_BODY_PLUS_ARTIFACTS"
      ]
    },

    "statement_status": {
      "type": "string",
      "enum": ["reported", "inferred", "unknown"]
    },

    "support_strength": {
      "type": "string",
      "enum": ["strong", "moderate", "weak", "missing", "overclaimed", "not_applicable"]
    },

    "assumption_provenance": {
      "type": "string",
      "enum": ["explicit", "inferred"],
      "description": "Whether the assumption is directly stated by the paper or inferred from the inspected material."
    },

    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "description": "How severely the paper's core claim would be affected if the assumption fails."
    },

    "locator_mode": {
      "type": "string",
      "enum": ["page_grounded", "structure_grounded", "source_limited"],
      "description": "Highest reliable locator precision available for this evidence."
    },

    "context_mode": {
      "type": "string",
      "enum": ["paper_only", "targeted_external_check", "externally_verified"],
      "description": "Whether analysis uses only the paper, targeted external checks, or independently verified external context."
    },

    "coverage_level": {
      "type": "string",
      "enum": ["sufficient", "partial", "limited"]
    },

    "evidence_material": {
      "type": "string",
      "enum": [
        "metadata",
        "abstract",
        "body_text",
        "methods",
        "experiments",
        "figures",
        "tables",
        "equations",
        "appendix",
        "supplement",
        "external_context"
      ]
    },

    "evidence_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "available", "missing", "note"],
      "properties": {
        "level": { "$ref": "#/$defs/coverage_level" },
        "available": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_material" }
        },
        "missing": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_material" }
        },
        "note": { "type": ["string", "null"] }
      }
    },

    "source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_grade", "evidence_coverage", "locator_mode", "context_mode"],
      "properties": {
        "evidence_grade": { "$ref": "#/$defs/evidence_grade" },
        "evidence_coverage": { "$ref": "#/$defs/evidence_coverage" },
        "locator_mode": { "$ref": "#/$defs/locator_mode" },
        "context_mode": { "$ref": "#/$defs/context_mode" }
      }
    },

    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "page", "figure", "table", "equation"],
      "properties": {
        "section": { "type": ["string", "null"] },
        "page":    { "type": ["integer", "null"], "minimum": 1 },
        "figure":  { "type": ["string", "null"] },
        "table":   { "type": ["string", "null"] },
        "equation":{ "type": ["string", "null"] }
      }
    },

    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "evidence_type",
        "locator_mode",
        "location",
        "source_block_id",
        "snippet",
        "paraphrase",
        "verification_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev-[0-9]{3,}$"
        },
        "source_type": {
          "type": "string",
          "enum": ["paper", "metadata", "external", "user_provided", "parser"]
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "title",
            "metadata",
            "abstract",
            "body_text",
            "figure",
            "table",
            "equation",
            "appendix",
            "supplement",
            "external_context"
          ]
        },
        "locator_mode": { "$ref": "#/$defs/locator_mode" },
        "location": { "$ref": "#/$defs/location" },
        "source_block_id": {
          "type": ["string", "null"],
          "description": "Stable upstream source block id when available."
        },
        "snippet": {
          "type": ["string", "null"],
          "description": "Short verbatim source excerpt from parsed material only. Null when no real excerpt is available."
        },
        "paraphrase": {
          "type": ["string", "null"],
          "description": "Concise model paraphrase of the source. Must not be presented as source text."
        },
        "verification_status": {
          "type": "string",
          "enum": ["verified", "needs_verification", "unavailable"]
        }
      }
    },

    "evidence_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "status", "evidence_refs", "support_strength"],
      "properties": {
        "text":             { "type": "string" },
        "status":           { "$ref": "#/$defs/statement_status" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        },
        "support_strength": { "$ref": "#/$defs/support_strength" }
      }
    },

    "assumption_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_text",
        "provenance",
        "risk_level",
        "status",
        "evidence_refs",
        "failure_mode",
        "testability"
      ],
      "properties": {
        "assumption_text": {
          "type": "string",
          "description": "Plain-language statement of the assumption."
        },
        "provenance":      { "$ref": "#/$defs/assumption_provenance" },
        "risk_level":      { "$ref": "#/$defs/risk_level" },
        "status":          { "$ref": "#/$defs/statement_status" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        },
        "failure_mode": {
          "type": ["string", "null"],
          "description": "What breaks if the assumption fails. Required in substance for high-risk assumptions."
        },
        "testability": {
          "type": ["string", "null"],
          "description": "How the assumption could be checked or stress-tested."
        }
      }
    },

    "paper_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors", "venue", "year", "doi", "arxiv", "url", "file_id", "version_note"],
      "properties": {
        "title":        { "type": ["string", "null"] },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "venue":        { "type": ["string", "null"] },
        "year":         { "type": ["integer", "null"] },
        "doi":          { "type": ["string", "null"] },
        "arxiv":        { "type": ["string", "null"] },
        "url":          { "type": ["string", "null"] },
        "file_id":      { "type": ["string", "null"] },
        "version_note": { "type": ["string", "null"] }
      }
    },

    "section_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "location"],
      "properties": {
        "title":    { "type": "string" },
        "summary":  { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },

    "located_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "caption_or_title", "role", "location", "inspected"],
      "properties": {
        "label":            { "type": "string" },
        "caption_or_title": { "type": ["string", "null"] },
        "role":             { "type": ["string", "null"] },
        "location":         { "$ref": "#/$defs/location" },
        "inspected":        { "type": "boolean" }
      }
    },

    "paper_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_type",
        "abstract_summary",
        "section_outline",
        "figures",
        "tables",
        "equations",
        "datasets",
        "metrics",
        "main_references"
      ],
      "properties": {
        "paper_type":       { "$ref": "#/$defs/paper_type" },
        "abstract_summary": { "type": ["string", "null"] },
        "section_outline": {
          "type": "array",
          "items": { "$ref": "#/$defs/section_item" }
        },
        "figures": {
          "type": "array",
          "items": { "$ref": "#/$defs/located_item" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/located_item" }
        },
        "equations": {
          "type": "array",
          "description": "Key equations or theorems inspected. Especially important for theory and method papers.",
          "items": { "$ref": "#/$defs/located_item" }
        },
        "datasets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "main_references": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "method_module_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_name",
        "purpose",
        "input",
        "operation",
        "output",
        "why_needed",
        "measured_effect",
        "evidence_refs"
      ],
      "properties": {
        "module_name": { "type": "string" },
        "purpose": { "type": ["string", "null"] },
        "input": { "type": ["string", "null"] },
        "operation": { "type": ["string", "null"] },
        "output": { "type": ["string", "null"] },
        "why_needed": { "type": ["string", "null"] },
        "measured_effect": {
          "type": ["string", "null"],
          "description": "Reported ablation or experiment effect if inspected. Null if not established."
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        }
      }
    },

    "method_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "previous_approach",
        "proposed_change",
        "mechanism",
        "expected_benefit",
        "main_modules",
        "assumptions"
      ],
      "properties": {
        "summary":           { "$ref": "#/$defs/evidence_statement" },
        "previous_approach": { "$ref": "#/$defs/evidence_statement" },
        "proposed_change":   { "$ref": "#/$defs/evidence_statement" },
        "mechanism":         { "$ref": "#/$defs/evidence_statement" },
        "expected_benefit":  { "$ref": "#/$defs/evidence_statement" },
        "main_modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/method_module_item" }
        },
        "assumptions": {
          "type": "array",
          "description": "Explicit or inferred assumptions identified in the method, with independent risk levels. High-risk assumptions must also appear in critical_review.fragile_assumptions.",
          "items": { "$ref": "#/$defs/assumption_item" }
        }
      }
    },

    "claim_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "importance",
        "claim",
        "evidence_refs",
        "support_strength",
        "support_reason",
        "scope_boundary",
        "unsupported_stronger_claim",
        "what_would_strengthen_it"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^cl-[0-9]{3,}$"
        },
        "importance": {
          "type": "string",
          "enum": ["core", "secondary", "context"]
        },
        "claim":              { "$ref": "#/$defs/evidence_statement" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        },
        "support_strength":        { "$ref": "#/$defs/support_strength" },
        "support_reason":          { "type": "string" },
        "scope_boundary":          { "type": ["string", "null"] },
        "unsupported_stronger_claim": {
          "type": ["string", "null"],
          "description": "A stronger conclusion that the current evidence does not justify."
        },
        "what_would_strengthen_it":{ "type": "string" }
      }
    },

    "novelty_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "paper_relative_delta", "field_novelty", "evidence_refs"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["paper_only", "not_externally_verified", "targeted_external_check", "externally_verified"]
        },
        "paper_relative_delta": {
          "type": ["string", "null"],
          "description": "What the paper changes relative to the prior work it discusses."
        },
        "field_novelty": {
          "type": ["string", "null"],
          "description": "Only populate after external novelty verification. Otherwise null."
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        }
      }
    },

    "evidence_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_support",
        "strongly_supported",
        "weakly_supported",
        "unsupported_or_overclaimed",
        "missing_evidence"
      ],
      "properties": {
        "overall_support": {
          "type": "string",
          "enum": ["strong", "moderate", "weak", "insufficient"]
        },
        "strongly_supported": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "weakly_supported": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "unsupported_or_overclaimed": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "missing_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "critical_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_limitations",
        "fragile_assumptions",
        "reviewer_questions",
        "reproducibility_risks",
        "evaluation_risks"
      ],
      "properties": {
        "main_limitations": {
          "type": "array",
          "description": "Scope, generalization, and result limitations grounded in inspected material.",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "fragile_assumptions": {
          "type": "array",
          "description": "High-risk assumptions whose failure would invalidate the core claim. Each item mirrors a method_summary.assumptions item with risk_level = high, with a plain-language explanation of the failure mode.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assumption_text", "failure_mode", "evidence_refs"],
            "properties": {
              "assumption_text": { "type": "string" },
              "failure_mode": {
                "type": "string",
                "description": "What breaks, and how severely, if this assumption does not hold."
              },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
              }
            }
          }
        },
        "reviewer_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reproducibility_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluation_risks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "open_question_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "why_it_matters", "suggested_next_step", "status", "evidence_refs"],
      "properties": {
        "question":           { "type": "string" },
        "why_it_matters":     { "type": "string" },
        "suggested_next_step":{ "type": "string" },
        "status":             { "$ref": "#/$defs/statement_status" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        }
      }
    },

    "research_value_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodological", "empirical", "application"],
      "description": "Separate research value ratings for different reader perspectives.",
      "properties": {
        "methodological": {
          "type": "string",
          "enum": ["high", "medium", "low", "unclear"],
          "description": "Value for researchers developing new methods or algorithms."
        },
        "empirical": {
          "type": "string",
          "enum": ["high", "medium", "low", "unclear"],
          "description": "Value for researchers needing benchmarks, datasets, or empirical findings."
        },
        "application": {
          "type": "string",
          "enum": ["high", "medium", "low", "unclear"],
          "description": "Value for practitioners applying the work to real systems."
        }
      }
    },

    "judgment_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_sentence_takeaway",
        "evidence_strength",
        "research_value",
        "reading_priority",
        "who_should_read"
      ],
      "properties": {
        "one_sentence_takeaway": { "type": "string" },
        "evidence_strength": {
          "type": "string",
          "enum": ["strong", "moderate", "weak", "insufficient"]
        },
        "research_value": {
          "$ref": "#/$defs/research_value_breakdown",
          "description": "Multi-dimensional research value. Replaces the single high/medium/low field from v1.0."
        },
        "reading_priority": {
          "type": "string",
          "enum": [
            "must_read",
            "read_core_sections",
            "skim",
            "low_priority",
            "insufficient_evidence"
          ]
        },
        "who_should_read": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "paper_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "identity",
        "evidence_grade",
        "source_boundary",
        "evidence_refs",
        "paper_map",
        "research_question",
        "method_summary",
        "contributions",
        "novelty_verification",
        "evaluation_or_findings",
        "limitations_or_unknowns",
        "uncertainties",
        "claim_evidence",
        "evidence_audit",
        "critical_review",
        "open_questions",
        "judgment_card"
      ],
      "description": "In quick_summary mode, only research_question and judgment_card carry substantive analysis. Other required fields must still be present as empty arrays or valid placeholder objects that satisfy this schema.",
      "properties": {
        "paper_id":   { "type": "string" },
        "identity":   { "$ref": "#/$defs/paper_identity" },
        "evidence_grade": { "$ref": "#/$defs/evidence_grade" },
        "source_boundary": { "$ref": "#/$defs/source_boundary" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "paper_map":          { "$ref": "#/$defs/paper_map" },
        "research_question":  { "$ref": "#/$defs/evidence_statement" },
        "method_summary":     { "$ref": "#/$defs/method_summary" },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "novelty_verification": { "$ref": "#/$defs/novelty_verification" },
        "evaluation_or_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "limitations_or_unknowns": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "uncertainties": {
          "type": "array",
          "items": { "type": "string" }
        },
        "claim_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_evidence_item" }
        },
        "evidence_audit":  { "$ref": "#/$defs/evidence_audit" },
        "critical_review": { "$ref": "#/$defs/critical_review" },
        "open_questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/open_question_item" }
        },
        "judgment_card": { "$ref": "#/$defs/judgment_card" }
      }
    }

  }
}

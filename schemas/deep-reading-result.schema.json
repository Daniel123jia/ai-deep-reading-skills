{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperscope:schemas:deep-reading-result:1.3",
  "title": "PaperScope AI Deep Reading Result",
  "description": "Structured output contract for PaperScope AI Deep Reading Skill v1.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_type",
    "input",
    "papers",
    "global_limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.3"
    },
    "analysis_type": {
      "type": "string",
      "enum": [
        "limited_reading",
        "deep_reading"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "reading_mode",
        "reading_goal",
        "user_question",
        "provided_materials"
      ],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "title",
            "abstract",
            "parsed_text",
            "parsed_pdf",
            "url",
            "doi",
            "arxiv",
            "mixed"
          ]
        },
        "reading_mode": {
          "type": "string",
          "enum": [
            "quick_summary",
            "standard",
            "reviewer_mode",
            "followup_mode",
            "method_only"
          ]
        },
        "reading_goal": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_question": {
          "type": [
            "string",
            "null"
          ]
        },
        "provided_materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/paper_report"
      }
    },
    "global_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "paper_type": {
      "type": "string",
      "enum": [
        "method",
        "empirical",
        "theory",
        "review",
        "general",
        "unknown"
      ]
    },
    "evidence_grade": {
      "type": "string",
      "enum": [
        "E0_TITLE_METADATA",
        "E1_ABSTRACT",
        "E2_BODY_TEXT",
        "E3_BODY_PLUS_ARTIFACTS"
      ]
    },
    "statement_status": {
      "type": "string",
      "enum": [
        "reported",
        "inferred",
        "unknown"
      ]
    },
    "support_strength": {
      "type": "string",
      "enum": [
        "strong",
        "moderate",
        "weak",
        "missing",
        "overclaimed",
        "not_applicable"
      ]
    },
    "assumption_provenance": {
      "type": "string",
      "enum": [
        "explicit",
        "inferred"
      ]
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "locator_mode": {
      "type": "string",
      "enum": [
        "page_grounded",
        "structure_grounded",
        "source_limited"
      ]
    },
    "context_mode": {
      "type": "string",
      "enum": [
        "paper_only",
        "targeted_external_check",
        "externally_verified"
      ]
    },
    "coverage_level": {
      "type": "string",
      "enum": [
        "sufficient",
        "partial",
        "limited"
      ]
    },
    "external_verification_status": {
      "type": "string",
      "enum": [
        "not_checked",
        "not_applicable",
        "partially_verified",
        "verified",
        "conflicted"
      ]
    },
    "open_question_origin": {
      "type": "string",
      "enum": [
        "author_stated",
        "analysis_derived"
      ]
    },
    "evidence_material": {
      "type": "string",
      "enum": [
        "metadata",
        "abstract",
        "body_text",
        "figures",
        "tables",
        "equations",
        "appendix",
        "supplement",
        "references",
        "external_sources",
        "code",
        "dataset"
      ]
    },
    "evidence_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "available_materials",
        "missing_materials",
        "note"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/coverage_level"
        },
        "available_materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_material"
          }
        },
        "missing_materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_material"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_grade",
        "evidence_coverage",
        "locator_mode",
        "context_mode",
        "boundary_note"
      ],
      "properties": {
        "evidence_grade": {
          "$ref": "#/$defs/evidence_grade"
        },
        "evidence_coverage": {
          "$ref": "#/$defs/evidence_coverage"
        },
        "locator_mode": {
          "$ref": "#/$defs/locator_mode"
        },
        "context_mode": {
          "$ref": "#/$defs/context_mode"
        },
        "boundary_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "page",
        "figure",
        "table",
        "equation"
      ],
      "properties": {
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "figure": {
          "type": [
            "string",
            "null"
          ]
        },
        "table": {
          "type": [
            "string",
            "null"
          ]
        },
        "equation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_type",
        "evidence_type",
        "source",
        "locator_mode",
        "location",
        "source_block_id",
        "snippet",
        "paraphrase",
        "verification_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev-[0-9]{3,}$"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "paper",
            "external",
            "user_material"
          ]
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "title",
            "metadata",
            "abstract",
            "body_text",
            "figure",
            "table",
            "equation",
            "appendix",
            "supplement",
            "external_context",
            "user_excerpt"
          ]
        },
        "source": {
          "type": "string"
        },
        "locator_mode": {
          "$ref": "#/$defs/locator_mode"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "source_block_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short verbatim source excerpt only. Never model-generated."
        },
        "paraphrase": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model summary of the source, never presented as original text."
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "needs_verification",
            "unavailable"
          ],
          "description": "Verification of source excerpt/locator, not scientific replication."
        }
      }
    },
    "evidence_statement": {
      "type": "object",
      "additionalProperties": false,
      "description": "reported = paper-explicit; inferred = grounded analysis; unknown = genuine non-establishment only.",
      "required": [
        "text",
        "status",
        "evidence_refs",
        "support_strength"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/statement_status"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        },
        "support_strength": {
          "$ref": "#/$defs/support_strength"
        }
      }
    },
    "claim_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "status"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/statement_status"
        }
      }
    },
    "assumption_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "assumption_text",
        "provenance",
        "risk_level",
        "status",
        "evidence_refs",
        "failure_mode",
        "testability"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "pattern": "^as-[0-9]{3,}$"
        },
        "assumption_text": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/assumption_provenance"
        },
        "risk_level": {
          "$ref": "#/$defs/risk_level"
        },
        "status": {
          "$ref": "#/$defs/statement_status"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        },
        "failure_mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "testability": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "paper_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "authors",
        "venue",
        "year",
        "doi",
        "arxiv",
        "url",
        "file_id",
        "version_note"
      ],
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "venue": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "arxiv": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "file_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "section_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "location"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "located_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "caption_or_title",
        "role",
        "location",
        "inspected"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "caption_or_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "inspected": {
          "type": "boolean"
        }
      }
    },
    "paper_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_type",
        "abstract_summary",
        "section_outline",
        "figures",
        "tables",
        "equations",
        "datasets",
        "metrics",
        "baselines",
        "ablations",
        "main_references"
      ],
      "properties": {
        "paper_type": {
          "$ref": "#/$defs/paper_type"
        },
        "abstract_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "section_outline": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section_item"
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/located_item"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/located_item"
          }
        },
        "equations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/located_item"
          }
        },
        "datasets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ablations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "main_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "method_module_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_name",
        "purpose",
        "input",
        "operation",
        "output",
        "why_needed",
        "measured_effect",
        "evidence_refs"
      ],
      "properties": {
        "module_name": {
          "type": "string"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        },
        "why_needed": {
          "type": [
            "string",
            "null"
          ]
        },
        "measured_effect": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        }
      }
    },
    "method_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "previous_approach",
        "proposed_change",
        "mechanism",
        "expected_benefit",
        "main_modules",
        "assumptions"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/evidence_statement"
        },
        "previous_approach": {
          "$ref": "#/$defs/evidence_statement"
        },
        "proposed_change": {
          "$ref": "#/$defs/evidence_statement"
        },
        "mechanism": {
          "$ref": "#/$defs/evidence_statement"
        },
        "expected_benefit": {
          "$ref": "#/$defs/evidence_statement"
        },
        "main_modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/method_module_item"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption_item"
          }
        }
      }
    },
    "claim_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "importance",
        "claim",
        "evidence_refs",
        "paper_internal_support",
        "support_reason",
        "scope_boundary",
        "unsupported_stronger_claim",
        "what_would_strengthen_it",
        "external_verification_status"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^cl-[0-9]{3,}$"
        },
        "importance": {
          "type": "string",
          "enum": [
            "core",
            "secondary",
            "context"
          ]
        },
        "claim": {
          "$ref": "#/$defs/claim_statement"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        },
        "paper_internal_support": {
          "$ref": "#/$defs/support_strength"
        },
        "support_reason": {
          "type": "string"
        },
        "scope_boundary": {
          "type": [
            "string",
            "null"
          ]
        },
        "unsupported_stronger_claim": {
          "type": [
            "string",
            "null"
          ]
        },
        "what_would_strengthen_it": {
          "type": "string",
          "minLength": 1
        },
        "external_verification_status": {
          "$ref": "#/$defs/external_verification_status"
        }
      }
    },
    "novelty_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "paper_relative_delta",
        "field_novelty"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "paper_only",
            "not_externally_verified",
            "targeted_external_check",
            "externally_verified"
          ]
        },
        "paper_relative_delta": {
          "$ref": "#/$defs/evidence_statement"
        },
        "field_novelty": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence_statement"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_internal_support",
        "external_verification_status",
        "strongly_supported",
        "weakly_supported",
        "unsupported_or_overclaimed",
        "missing_evidence"
      ],
      "properties": {
        "paper_internal_support": {
          "type": "string",
          "enum": [
            "strong",
            "moderate",
            "weak",
            "insufficient"
          ]
        },
        "external_verification_status": {
          "$ref": "#/$defs/external_verification_status"
        },
        "strongly_supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        },
        "weakly_supported": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        },
        "unsupported_or_overclaimed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        },
        "missing_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fragile_assumption_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "failure_mode",
        "evidence_refs"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "pattern": "^as-[0-9]{3,}$"
        },
        "failure_mode": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        }
      }
    },
    "critical_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_limitations",
        "fragile_assumptions",
        "reviewer_questions",
        "reproducibility_risks",
        "evaluation_risks",
        "applicability_boundary"
      ],
      "properties": {
        "analysis_limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        },
        "fragile_assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fragile_assumption_item"
          }
        },
        "reviewer_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reproducibility_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evaluation_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "applicability_boundary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        }
      }
    },
    "open_question_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "origin",
        "why_it_matters",
        "suggested_validation",
        "evidence_refs"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/open_question_origin"
        },
        "why_it_matters": {
          "type": "string"
        },
        "suggested_validation": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        }
      }
    },
    "reading_guide_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "target_type",
        "target_label",
        "reason",
        "evidence_refs"
      ],
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "must_read",
            "recommended",
            "skim"
          ]
        },
        "target_type": {
          "type": "string",
          "enum": [
            "section",
            "figure",
            "table",
            "equation",
            "appendix",
            "general"
          ]
        },
        "target_label": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        }
      }
    },
    "reading_guide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "twenty_minute_path"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading_guide_item"
          }
        },
        "twenty_minute_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "contradiction_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contradiction_id",
        "description",
        "evidence_refs",
        "impact",
        "resolution_needed"
      ],
      "properties": {
        "contradiction_id": {
          "type": "string",
          "pattern": "^cx-[0-9]{3,}$"
        },
        "description": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^ev-[0-9]{3,}$"
          }
        },
        "impact": {
          "type": "string"
        },
        "resolution_needed": {
          "type": "string"
        }
      }
    },
    "research_value_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "rationale"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unclear",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "research_value_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodological",
        "empirical",
        "application"
      ],
      "properties": {
        "methodological": {
          "$ref": "#/$defs/research_value_dimension"
        },
        "empirical": {
          "$ref": "#/$defs/research_value_dimension"
        },
        "application": {
          "$ref": "#/$defs/research_value_dimension"
        }
      }
    },
    "reading_priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "reason"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "must_read",
            "read_core_sections",
            "skim",
            "low_priority",
            "insufficient_evidence"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "judgment_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_sentence_takeaway",
        "paper_internal_evidence_strength",
        "research_value",
        "reading_priority",
        "who_should_read"
      ],
      "properties": {
        "one_sentence_takeaway": {
          "type": "string"
        },
        "paper_internal_evidence_strength": {
          "type": "string",
          "enum": [
            "strong",
            "moderate",
            "weak",
            "insufficient"
          ]
        },
        "research_value": {
          "$ref": "#/$defs/research_value_breakdown"
        },
        "reading_priority": {
          "$ref": "#/$defs/reading_priority"
        },
        "who_should_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "paper_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "identity",
        "source_boundary",
        "evidence_refs",
        "paper_map",
        "research_question",
        "method_summary",
        "contributions",
        "novelty_verification",
        "evaluation_or_findings",
        "author_acknowledged_limitations",
        "unresolved_unknowns",
        "claim_evidence",
        "evidence_audit",
        "critical_review",
        "open_questions",
        "reading_guide",
        "contradictions",
        "judgment_card"
      ],
      "properties": {
        "paper_id": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/paper_identity"
        },
        "source_boundary": {
          "$ref": "#/$defs/source_boundary"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "paper_map": {
          "$ref": "#/$defs/paper_map"
        },
        "research_question": {
          "$ref": "#/$defs/evidence_statement"
        },
        "method_summary": {
          "$ref": "#/$defs/method_summary"
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        },
        "novelty_verification": {
          "$ref": "#/$defs/novelty_verification"
        },
        "evaluation_or_findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        },
        "author_acknowledged_limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_statement"
          }
        },
        "unresolved_unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim_evidence_item"
          }
        },
        "evidence_audit": {
          "$ref": "#/$defs/evidence_audit"
        },
        "critical_review": {
          "$ref": "#/$defs/critical_review"
        },
        "open_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/open_question_item"
          }
        },
        "reading_guide": {
          "$ref": "#/$defs/reading_guide"
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contradiction_item"
          }
        },
        "judgment_card": {
          "$ref": "#/$defs/judgment_card"
        }
      }
    }
  }
}

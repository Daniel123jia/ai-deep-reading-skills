{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paperscope:schemas:deep-reading-result:1.1",
  "title": "PaperScope AI Deep Reading Result",
  "description": "Structured output contract for the PaperScope AI deep reading skill. Version 1.1 adds reading_mode routing, assumption fields, fragile_assumptions, equations support, and split judgment_card research_value.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_type",
    "input",
    "papers",
    "global_limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "analysis_type": {
      "type": "string",
      "enum": ["limited_reading", "deep_reading"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "reading_mode", "reading_goal", "user_question", "provided_materials"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["title", "abstract", "parsed_text", "parsed_pdf", "url", "doi", "arxiv", "mixed"]
        },
        "reading_mode": {
          "type": "string",
          "enum": ["quick_summary", "standard", "reviewer_mode", "followup_mode", "method_only"],
          "description": "Resolved reading mode. Governs which output sections are required and where emphasis is placed."
        },
        "reading_goal": {
          "type": ["string", "null"],
          "description": "Raw user-stated goal or intent, before resolution to reading_mode."
        },
        "user_question": {
          "type": ["string", "null"]
        },
        "provided_materials": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "Up to 5 papers per call. For larger sets, run multiple calls and merge at the application layer.",
      "items": { "$ref": "#/$defs/paper_report" }
    },
    "global_limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  },

  "$defs": {

    "paper_type": {
      "type": "string",
      "enum": ["method", "empirical", "theory", "review", "general", "unknown"]
    },

    "evidence_grade": {
      "type": "string",
      "enum": [
        "E0_TITLE_METADATA",
        "E1_ABSTRACT",
        "E2_BODY_TEXT",
        "E3_BODY_PLUS_ARTIFACTS"
      ]
    },

    "statement_status": {
      "type": "string",
      "enum": ["reported", "inferred", "unknown"]
    },

    "support_strength": {
      "type": "string",
      "enum": ["strong", "moderate", "weak", "missing", "overclaimed", "not_applicable"]
    },

    "assumption_type": {
      "type": "string",
      "enum": ["explicit", "inferred", "high_risk"],
      "description": "explicit = stated by authors; inferred = implied by design; high_risk = failure invalidates core claim."
    },

    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "page", "figure", "table", "equation"],
      "properties": {
        "section": { "type": ["string", "null"] },
        "page":    { "type": ["integer", "null"], "minimum": 1 },
        "figure":  { "type": ["string", "null"] },
        "table":   { "type": ["string", "null"] },
        "equation":{ "type": ["string", "null"] }
      }
    },

    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidence_type", "source", "location", "note"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev-[0-9]{3,}$"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "title",
            "metadata",
            "abstract",
            "body_text",
            "figure",
            "table",
            "equation",
            "appendix",
            "supplement",
            "external_context"
          ]
        },
        "source":   { "type": "string" },
        "location": { "$ref": "#/$defs/location" },
        "note": {
          "type": "string",
          "description": "Short excerpt or accurate paraphrase. Keep it brief. Do not reproduce long passages."
        }
      }
    },

    "evidence_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "status", "evidence_refs", "support_strength"],
      "properties": {
        "text":             { "type": "string" },
        "status":           { "$ref": "#/$defs/statement_status" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        },
        "support_strength": { "$ref": "#/$defs/support_strength" }
      }
    },

    "assumption_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_text", "assumption_type", "status", "evidence_refs", "risk_note"],
      "properties": {
        "assumption_text": {
          "type": "string",
          "description": "Plain-language statement of the assumption."
        },
        "assumption_type": { "$ref": "#/$defs/assumption_type" },
        "status":          { "$ref": "#/$defs/statement_status" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        },
        "risk_note": {
          "type": ["string", "null"],
          "description": "For high_risk assumptions: explain what breaks if this assumption fails. Null for others."
        }
      }
    },

    "paper_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors", "venue", "year", "doi", "arxiv", "url", "file_id", "version_note"],
      "properties": {
        "title":        { "type": ["string", "null"] },
        "authors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "venue":        { "type": ["string", "null"] },
        "year":         { "type": ["integer", "null"] },
        "doi":          { "type": ["string", "null"] },
        "arxiv":        { "type": ["string", "null"] },
        "url":          { "type": ["string", "null"] },
        "file_id":      { "type": ["string", "null"] },
        "version_note": { "type": ["string", "null"] }
      }
    },

    "section_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "location"],
      "properties": {
        "title":    { "type": "string" },
        "summary":  { "type": "string" },
        "location": { "$ref": "#/$defs/location" }
      }
    },

    "located_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "caption_or_title", "role", "location", "inspected"],
      "properties": {
        "label":            { "type": "string" },
        "caption_or_title": { "type": ["string", "null"] },
        "role":             { "type": ["string", "null"] },
        "location":         { "$ref": "#/$defs/location" },
        "inspected":        { "type": "boolean" }
      }
    },

    "paper_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_type",
        "abstract_summary",
        "section_outline",
        "figures",
        "tables",
        "equations",
        "datasets",
        "metrics",
        "main_references"
      ],
      "properties": {
        "paper_type":       { "$ref": "#/$defs/paper_type" },
        "abstract_summary": { "type": ["string", "null"] },
        "section_outline": {
          "type": "array",
          "items": { "$ref": "#/$defs/section_item" }
        },
        "figures": {
          "type": "array",
          "items": { "$ref": "#/$defs/located_item" }
        },
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/located_item" }
        },
        "equations": {
          "type": "array",
          "description": "Key equations or theorems inspected. Especially important for theory and method papers.",
          "items": { "$ref": "#/$defs/located_item" }
        },
        "datasets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "array",
          "items": { "type": "string" }
        },
        "main_references": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "method_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "previous_approach",
        "proposed_change",
        "mechanism",
        "expected_benefit",
        "main_modules",
        "assumptions"
      ],
      "properties": {
        "summary":           { "$ref": "#/$defs/evidence_statement" },
        "previous_approach": { "$ref": "#/$defs/evidence_statement" },
        "proposed_change":   { "$ref": "#/$defs/evidence_statement" },
        "mechanism":         { "$ref": "#/$defs/evidence_statement" },
        "expected_benefit":  { "$ref": "#/$defs/evidence_statement" },
        "main_modules": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "assumptions": {
          "type": "array",
          "description": "Explicit, inferred, and high-risk assumptions identified in the method. High-risk assumptions must also appear in critical_review.fragile_assumptions.",
          "items": { "$ref": "#/$defs/assumption_item" }
        }
      }
    },

    "claim_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "evidence_refs", "support_strength", "what_would_strengthen_it"],
      "properties": {
        "claim":              { "$ref": "#/$defs/evidence_statement" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        },
        "support_strength":        { "$ref": "#/$defs/support_strength" },
        "what_would_strengthen_it":{ "type": "string" }
      }
    },

    "evidence_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_support",
        "strongly_supported",
        "weakly_supported",
        "unsupported_or_overclaimed",
        "missing_evidence"
      ],
      "properties": {
        "overall_support": {
          "type": "string",
          "enum": ["strong", "moderate", "weak", "insufficient"]
        },
        "strongly_supported": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "weakly_supported": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "unsupported_or_overclaimed": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "missing_evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "critical_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_limitations",
        "fragile_assumptions",
        "reviewer_questions",
        "reproducibility_risks",
        "evaluation_risks"
      ],
      "properties": {
        "main_limitations": {
          "type": "array",
          "description": "Scope, generalization, and result limitations grounded in inspected material.",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "fragile_assumptions": {
          "type": "array",
          "description": "High-risk assumptions whose failure would invalidate the core claim. Each item mirrors a high_risk entry from method_summary.assumptions, with a plain-language explanation of the failure mode.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assumption_text", "failure_mode", "evidence_refs"],
            "properties": {
              "assumption_text": { "type": "string" },
              "failure_mode": {
                "type": "string",
                "description": "What breaks, and how severely, if this assumption does not hold."
              },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
              }
            }
          }
        },
        "reviewer_questions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reproducibility_risks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluation_risks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "open_question_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "why_it_matters", "suggested_next_step", "status", "evidence_refs"],
      "properties": {
        "question":           { "type": "string" },
        "why_it_matters":     { "type": "string" },
        "suggested_next_step":{ "type": "string" },
        "status":             { "$ref": "#/$defs/statement_status" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ev-[0-9]{3,}$" }
        }
      }
    },

    "research_value_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodological", "empirical", "application"],
      "description": "Separate research value ratings for different reader perspectives.",
      "properties": {
        "methodological": {
          "type": "string",
          "enum": ["high", "medium", "low", "unclear"],
          "description": "Value for researchers developing new methods or algorithms."
        },
        "empirical": {
          "type": "string",
          "enum": ["high", "medium", "low", "unclear"],
          "description": "Value for researchers needing benchmarks, datasets, or empirical findings."
        },
        "application": {
          "type": "string",
          "enum": ["high", "medium", "low", "unclear"],
          "description": "Value for practitioners applying the work to real systems."
        }
      }
    },

    "judgment_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_sentence_takeaway",
        "evidence_strength",
        "research_value",
        "reading_priority",
        "who_should_read"
      ],
      "properties": {
        "one_sentence_takeaway": { "type": "string" },
        "evidence_strength": {
          "type": "string",
          "enum": ["strong", "moderate", "weak", "insufficient"]
        },
        "research_value": {
          "$ref": "#/$defs/research_value_breakdown",
          "description": "Multi-dimensional research value. Replaces the single high/medium/low field from v1.0."
        },
        "reading_priority": {
          "type": "string",
          "enum": [
            "must_read",
            "read_core_sections",
            "skim",
            "low_priority",
            "insufficient_evidence"
          ]
        },
        "who_should_read": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "paper_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper_id",
        "identity",
        "evidence_grade",
        "evidence_refs",
        "paper_map",
        "research_question",
        "method_summary",
        "contributions",
        "evaluation_or_findings",
        "limitations_or_unknowns",
        "uncertainties",
        "claim_evidence",
        "evidence_audit",
        "critical_review",
        "open_questions",
        "judgment_card"
      ],
      "description": "In quick_summary mode, all fields except research_question and judgment_card may be empty arrays or null. They must still be present to satisfy the schema.",
      "properties": {
        "paper_id":   { "type": "string" },
        "identity":   { "$ref": "#/$defs/paper_identity" },
        "evidence_grade": { "$ref": "#/$defs/evidence_grade" },
        "evidence_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "paper_map":          { "$ref": "#/$defs/paper_map" },
        "research_question":  { "$ref": "#/$defs/evidence_statement" },
        "method_summary":     { "$ref": "#/$defs/method_summary" },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "evaluation_or_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "limitations_or_unknowns": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_statement" }
        },
        "uncertainties": {
          "type": "array",
          "items": { "type": "string" }
        },
        "claim_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim_evidence_item" }
        },
        "evidence_audit":  { "$ref": "#/$defs/evidence_audit" },
        "critical_review": { "$ref": "#/$defs/critical_review" },
        "open_questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/open_question_item" }
        },
        "judgment_card": { "$ref": "#/$defs/judgment_card" }
      }
    }

  }
}
